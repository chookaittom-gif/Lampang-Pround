# คัดลอกเป็น .env แล้วกรอกค่าจริง — ห้าม commit .env
# Google service account (แชร์ Spreadsheet ให้ email ของ service account เป็น Viewer — read-only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=

# Cloudflare D1 REST. Set DRIVE_ONLY=1 to preserve existing Drive URLs and skip R2.
DRIVE_ONLY=1
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
R2_BUCKET=lampang-pround-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
